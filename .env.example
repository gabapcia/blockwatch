# Blockwatch Environment Variables Example
# Copy this file to .env and update the values for your environment

# Logging Configuration
LOG_LEVEL="INFO"

# Telemetry Configuration
TELEMETRY_SERVICE_NAME="blockwatch"

# Global Storage Engine Configurations
ENGINES_STORAGE_REDIS_ADDRESS="localhost:6379"
ENGINES_STORAGE_REDIS_USERNAME=""
ENGINES_STORAGE_REDIS_PASSWORD=""
ENGINES_STORAGE_REDIS_DB="0"

ENGINES_STORAGE_POSTGRES_DSN="postgres://user:password@localhost:5432/blockwatch"

# Global Messaging Engine Configurations
ENGINES_MESSAGING_REDIS_ADDRESS="localhost:6379"
ENGINES_MESSAGING_REDIS_USERNAME=""
ENGINES_MESSAGING_REDIS_PASSWORD=""
ENGINES_MESSAGING_REDIS_DB="0"

ENGINES_MESSAGING_RABBITMQ_URI="amqp://guest:guest@localhost:5672/"

# Wallet Registry Configuration
WALLETREGISTRY_WALLET_STORAGE_ENGINE="REDIS"
# Alternative: inline configuration
# WALLETREGISTRY_WALLET_STORAGE_CONFIG_REDIS_ADDRESS="localhost:6379"
# WALLETREGISTRY_WALLET_STORAGE_CONFIG_REDIS_USERNAME=""
# WALLETREGISTRY_WALLET_STORAGE_CONFIG_REDIS_PASSWORD=""
# WALLETREGISTRY_WALLET_STORAGE_CONFIG_REDIS_DB="0"

# Wallet Watch Configuration
WALLETWATCH_MAX_PROCESSING_TIME="5m"

WALLETWATCH_IDEMPOTENCY_GUARD_ENGINE="REDIS"
# Alternative: inline configuration
# WALLETWATCH_IDEMPOTENCY_GUARD_CONFIG_REDIS_ADDRESS="localhost:6379"
# WALLETWATCH_IDEMPOTENCY_GUARD_CONFIG_REDIS_USERNAME=""
# WALLETWATCH_IDEMPOTENCY_GUARD_CONFIG_REDIS_PASSWORD=""
# WALLETWATCH_IDEMPOTENCY_GUARD_CONFIG_REDIS_DB="1"

WALLETWATCH_WALLET_STORAGE_ENGINE="REDIS"
# Alternative: inline configuration
# WALLETWATCH_WALLET_STORAGE_CONFIG_REDIS_ADDRESS="localhost:6379"
# WALLETWATCH_WALLET_STORAGE_CONFIG_REDIS_USERNAME=""
# WALLETWATCH_WALLET_STORAGE_CONFIG_REDIS_PASSWORD=""
# WALLETWATCH_WALLET_STORAGE_CONFIG_REDIS_DB="0"

WALLETWATCH_TRANSACTION_NOTIFIER_ENGINE="REDIS"
# Alternative: inline configuration
# WALLETWATCH_TRANSACTION_NOTIFIER_CONFIG_REDIS_ADDRESS="localhost:6379"
# WALLETWATCH_TRANSACTION_NOTIFIER_CONFIG_REDIS_USERNAME=""
# WALLETWATCH_TRANSACTION_NOTIFIER_CONFIG_REDIS_PASSWORD=""
# WALLETWATCH_TRANSACTION_NOTIFIER_CONFIG_REDIS_DB="0"

# Chain Stream Configuration
CHAINSTREAM_CHECKPOINT_STORAGE_ENGINE="REDIS"
# Alternative: inline configuration
# CHAINSTREAM_CHECKPOINT_STORAGE_CONFIG_REDIS_ADDRESS="localhost:6379"
# CHAINSTREAM_CHECKPOINT_STORAGE_CONFIG_REDIS_USERNAME=""
# CHAINSTREAM_CHECKPOINT_STORAGE_CONFIG_REDIS_PASSWORD=""
# CHAINSTREAM_CHECKPOINT_STORAGE_CONFIG_REDIS_DB="2"

CHAINSTREAM_RETRY_ATTEMPTS="3"
CHAINSTREAM_RETRY_DELAY="1s"
CHAINSTREAM_RETRY_MAX_DELAY="5s"

# Blockchain Network Configurations
CHAINSTREAM_NETWORKS_ETHEREUM_TIMEOUT="5s"
CHAINSTREAM_NETWORKS_ETHEREUM_RETRY_WAIT_MIN="1s"
CHAINSTREAM_NETWORKS_ETHEREUM_RETRY_WAIT_MAX="5s"
CHAINSTREAM_NETWORKS_ETHEREUM_RETRY_MAX="2"
CHAINSTREAM_NETWORKS_ETHEREUM_PROVIDER_ENDPOINT="https://mainnet.infura.io/v3/YOUR_PROJECT_ID"

CHAINSTREAM_DISPATCH_FAILURE_HANDLER_ENGINE="REDIS"
# Alternative: inline configuration
# CHAINSTREAM_DISPATCH_FAILURE_HANDLER_CONFIG_REDIS_ADDRESS="localhost:6379"
# CHAINSTREAM_DISPATCH_FAILURE_HANDLER_CONFIG_REDIS_USERNAME=""
# CHAINSTREAM_DISPATCH_FAILURE_HANDLER_CONFIG_REDIS_PASSWORD=""
# CHAINSTREAM_DISPATCH_FAILURE_HANDLER_CONFIG_REDIS_DB="0"
