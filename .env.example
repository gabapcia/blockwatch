# =============================================================================
# BLOCKWATCH CONFIGURATION
# =============================================================================
# This file contains example environment variables for the Blockwatch application.
# Copy this file to .env and modify the values according to your setup.

# =============================================================================
# CORE CONFIGURATION
# =============================================================================
# Service name used in telemetry systems (logs, traces, metrics)
SERVICE_NAME=blockwatch

# Log level for the application
# Accepted values: DEBUG, INFO, WARN, ERROR, PANIC, FATAL
LOG_LEVEL=INFO

# =============================================================================
# GLOBAL STORAGE ENGINES
# =============================================================================
# Optional - Redis storage configuration (global)
ENGINES_STORAGE_REDIS_ADDRESS=localhost:6379
ENGINES_STORAGE_REDIS_USERNAME=
ENGINES_STORAGE_REDIS_PASSWORD=
ENGINES_STORAGE_REDIS_DB=0

# Optional - PostgreSQL storage configuration (global)
ENGINES_STORAGE_POSTGRESQL_DSN=postgres://user:password@localhost:5432/blockwatch

# =============================================================================
# GLOBAL MESSAGING ENGINES
# =============================================================================
# Optional - Redis messaging configuration (global)
ENGINES_MESSAGING_REDIS_ADDRESS=localhost:6379
ENGINES_MESSAGING_REDIS_USERNAME=
ENGINES_MESSAGING_REDIS_PASSWORD=
ENGINES_MESSAGING_REDIS_DB=0

# Optional - RabbitMQ messaging configuration (global)
ENGINES_MESSAGING_RABBITMQ_URI=amqp://user:password@localhost:5672/

# =============================================================================
# WALLET REGISTRY CONFIGURATION
# =============================================================================
# Storage backend for wallet registration data
# Options: Use global engine or inline config

# Option 1: Use global storage engine
WALLETREGISTRY_WALLET_STORAGE_ENGINE=REDIS
# or
# WALLETREGISTRY_WALLET_STORAGE_ENGINE=POSTGRESQL

# Option 2: Use inline Redis configuration
# WALLETREGISTRY_WALLET_STORAGE_REDIS_ADDRESS=localhost:6379
# WALLETREGISTRY_WALLET_STORAGE_REDIS_USERNAME=
# WALLETREGISTRY_WALLET_STORAGE_REDIS_PASSWORD=
# WALLETREGISTRY_WALLET_STORAGE_REDIS_DB=1

# Option 3: Use inline PostgreSQL configuration
# WALLETREGISTRY_WALLET_STORAGE_POSTGRESQL_DSN=postgres://user:password@localhost:5432/walletregistry

# =============================================================================
# WALLET WATCH CONFIGURATION
# =============================================================================
WALLETWATCH_MAX_PROCESSING_TIME=5m

# Optional - Idempotency guard storage
# WALLETWATCH_IDEMPOTENCY_GUARD_ENGINE=REDIS
# or inline config:
# WALLETWATCH_IDEMPOTENCY_GUARD_REDIS_ADDRESS=localhost:6379
# WALLETWATCH_IDEMPOTENCY_GUARD_REDIS_USERNAME=
# WALLETWATCH_IDEMPOTENCY_GUARD_REDIS_PASSWORD=
# WALLETWATCH_IDEMPOTENCY_GUARD_REDIS_DB=2

# Wallet storage configuration
WALLETWATCH_WALLET_STORAGE_ENGINE=REDIS
# or inline config:
# WALLETWATCH_WALLET_STORAGE_REDIS_ADDRESS=localhost:6379
# WALLETWATCH_WALLET_STORAGE_REDIS_USERNAME=
# WALLETWATCH_WALLET_STORAGE_REDIS_PASSWORD=
# WALLETWATCH_WALLET_STORAGE_REDIS_DB=3

# Transaction notifier messaging configuration
WALLETWATCH_TRANSACTION_NOTIFIER_ENGINE=REDIS
WALLETWATCH_TRANSACTION_NOTIFIER_REDIS_STREAM=walletwatch:streams:transactions

# Alternative: Use RabbitMQ for transaction notifications
# WALLETWATCH_TRANSACTION_NOTIFIER_ENGINE=RABBITMQ
# WALLETWATCH_TRANSACTION_NOTIFIER_RABBITMQ_EXCHANGE=transactions
# WALLETWATCH_TRANSACTION_NOTIFIER_RABBITMQ_ROUTING_KEY=wallet.transaction

# Alternative: Use inline Redis messaging config
# WALLETWATCH_TRANSACTION_NOTIFIER_REDIS_ADDRESS=localhost:6379
# WALLETWATCH_TRANSACTION_NOTIFIER_REDIS_USERNAME=
# WALLETWATCH_TRANSACTION_NOTIFIER_REDIS_PASSWORD=
# WALLETWATCH_TRANSACTION_NOTIFIER_REDIS_DB=4
# WALLETWATCH_TRANSACTION_NOTIFIER_REDIS_STREAM=walletwatch:streams:transactions

# Alternative: Use inline RabbitMQ messaging config
# WALLETWATCH_TRANSACTION_NOTIFIER_RABBITMQ_URI=amqp://user:password@localhost:5672/
# WALLETWATCH_TRANSACTION_NOTIFIER_RABBITMQ_EXCHANGE=transactions
# WALLETWATCH_TRANSACTION_NOTIFIER_RABBITMQ_ROUTING_KEY=wallet.transaction

# =============================================================================
# CHAIN STREAM CONFIGURATION
# =============================================================================
# Optional - Checkpoint storage
# CHAINSTREAM_CHECKPOINT_STORAGE_ENGINE=REDIS
# or inline config:
# CHAINSTREAM_CHECKPOINT_STORAGE_REDIS_ADDRESS=localhost:6379
# CHAINSTREAM_CHECKPOINT_STORAGE_REDIS_USERNAME=
# CHAINSTREAM_CHECKPOINT_STORAGE_REDIS_PASSWORD=
# CHAINSTREAM_CHECKPOINT_STORAGE_REDIS_DB=5

# Optional - Retry configuration
CHAINSTREAM_RETRY_ATTEMPTS=3
CHAINSTREAM_RETRY_DELAY=1s
CHAINSTREAM_RETRY_MAX_DELAY=5s

# Ethereum network configuration
CHAINSTREAM_NETWORKS_ETHEREUM_PROVIDER_ENDPOINT=https://mainnet.infura.io/v3/YOUR_PROJECT_ID
CHAINSTREAM_NETWORKS_ETHEREUM_TIMEOUT=5s
CHAINSTREAM_NETWORKS_ETHEREUM_RETRY_WAIT_MIN=1s
CHAINSTREAM_NETWORKS_ETHEREUM_RETRY_WAIT_MAX=5s
CHAINSTREAM_NETWORKS_ETHEREUM_RETRY_MAX=2

# Solana network configuration
CHAINSTREAM_NETWORKS_SOLANA_PROVIDER_ENDPOINT=https://api.mainnet-beta.solana.com
CHAINSTREAM_NETWORKS_SOLANA_TIMEOUT=5s
CHAINSTREAM_NETWORKS_SOLANA_RETRY_WAIT_MIN=1s
CHAINSTREAM_NETWORKS_SOLANA_RETRY_WAIT_MAX=5s
CHAINSTREAM_NETWORKS_SOLANA_RETRY_MAX=2

# Optional - Dispatch failure notifier
# CHAINSTREAM_DISPATCH_FAILURE_NOTIFIER_ENGINE=REDIS
# CHAINSTREAM_DISPATCH_FAILURE_NOTIFIER_REDIS_STREAM=chainstream:streams:dispatch-failures

# Alternative: Use RabbitMQ for dispatch failures
# CHAINSTREAM_DISPATCH_FAILURE_NOTIFIER_ENGINE=RABBITMQ
# CHAINSTREAM_DISPATCH_FAILURE_NOTIFIER_RABBITMQ_EXCHANGE=failures
# CHAINSTREAM_DISPATCH_FAILURE_NOTIFIER_RABBITMQ_ROUTING_KEY=chainstream.dispatch.failure

# Alternative: Use inline Redis messaging config for dispatch failures
# CHAINSTREAM_DISPATCH_FAILURE_NOTIFIER_REDIS_ADDRESS=localhost:6379
# CHAINSTREAM_DISPATCH_FAILURE_NOTIFIER_REDIS_USERNAME=
# CHAINSTREAM_DISPATCH_FAILURE_NOTIFIER_REDIS_PASSWORD=
# CHAINSTREAM_DISPATCH_FAILURE_NOTIFIER_REDIS_DB=6
# CHAINSTREAM_DISPATCH_FAILURE_NOTIFIER_REDIS_STREAM=chainstream:streams:dispatch-failures

# Alternative: Use inline RabbitMQ messaging config for dispatch failures
# CHAINSTREAM_DISPATCH_FAILURE_NOTIFIER_RABBITMQ_URI=amqp://user:password@localhost:5672/
# CHAINSTREAM_DISPATCH_FAILURE_NOTIFIER_RABBITMQ_EXCHANGE=failures
# CHAINSTREAM_DISPATCH_FAILURE_NOTIFIER_RABBITMQ_ROUTING_KEY=chainstream.dispatch.failure

# =============================================================================
# NOTES
# =============================================================================
# 1. For storage and messaging configurations, you can either:
#    - Use global engines (set ENGINE=REDIS or ENGINE=POSTGRESQL/RABBITMQ)
#    - Use inline configurations (set the specific engine variables directly)
#    These options are mutually exclusive.
#
# 2. For production environments, ensure proper authentication and encryption
#    are configured for all external services.
#
# 3. Time durations can be specified with units: ns, us, ms, s, m, h
#    Examples: 30s, 5m, 1h30m
#
# 4. Replace placeholder values (like YOUR_PROJECT_ID) with actual values
#    from your service providers.
#
# 5. Optional configurations are marked with "# Optional" comments.
#    Uncomment and configure them as needed for your specific use case.
